<?php

namespace sf_moocms\MoocmsBundle\Entity;

use Doctrine\ORM\Mapping as ORM;

/**
 * courseLesson
 *
 * @ORM\Table()
 * @ORM\Entity(repositoryClass="sf_moocms\MoocmsBundle\Entity\courseLessonRepository")
 */
class CourseLesson
{
    /**
     * @var integer
     *
     * @ORM\Column(name="id", type="integer")
     * @ORM\Id
     * @ORM\GeneratedValue(strategy="AUTO")
     */
    private $id;

    /**
     * @var integer
     *
     * @ORM\Column(name="position", type="integer")
     */
    private $position;


  /**
   * @ORM\ManyToOne(targetEntity="sf_moocms\MoocmsBundle\Entity\Course")
   * @ORM\JoinColumn(nullable=false)
   */
  private $course;

  /**
   * @ORM\ManyToOne(targetEntity="sf_moocms\MoocmsBundle\Entity\Lesson")
   * @ORM\JoinColumn(nullable=false)
   */
  private $lesson;


    /**
     * Get id
     *
     * @return integer 
     */
    public function getId()
    {
        return $this->id;
    }

    /**
     * Set position
     *
     * @param integer $position
     * @return courseLesson
     */
    public function setPosition($position)
    {
        $this->position = $position;

        return $this;
    }

    /**
     * Get position
     *
     * @return integer 
     */
    public function getPosition()
    {
        return $this->position;
    }
}
