{% extends 'MoocmsBundle::layout.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

  {% block body %}

    <div class="container page-content">      
      <div class="row">
        <div class="col-md-12">
          <div class="card card-default">
            <div class="card-header">
              <h2>Liste des catégories</h2>
            </div>
            <div class="card-body">
              {% if categories %}
                <table class="table table-hover table-striped table-bordered">
                  <thead align="center">
                    <th>Intitulé</th>
                    <th>Description</th>
                    <th>Modifier</th>
                  </thead>
                  {% for category in categories %}
                    <tr>
                      <td>{{ category.name }}</td>
                      <td>{{ category.description }}</td>
                      <td align="center"><a title="Modifier" href="{{ path('moocms_edit_category', {'id': category.id}) }}"><i class="fa fa-edit"></i></a></td>
                    </tr>
                  {% endfor %}
                </table>
              {% else %}
                <p><b>No categories match...</b></p>
              {% endif %}
            </div>
            <div class="card-footer">

              <div class="form-group">
                <a class="btn btn-primary" href="{{ path('moocms_add_category') }}" ><i class="fa fa-plus-square"></i> Ajouter une catégorie</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  {% endblock %}
