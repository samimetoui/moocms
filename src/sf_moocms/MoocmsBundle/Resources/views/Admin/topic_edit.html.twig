{% extends 'MoocmsBundle::layout.html.twig' %}

{% block title %}Modifier une discipline{% endblock %}

  {% block body %}

    <div class="container page-content">
      <div class="row">
        <div class="col-md-12">
          <div class="card card-default">
            <div class="card-header">
              <h2>Modifier une discipline</h2>
            </div>
            <div class="card-body">

              {{ form_start(form, {'attr': {'class': 'form-horizontal'} }) }}

              <div class="form-group">
                {{ form_label(form.name, 'Intitulé') }}
                {{ form_errors(form.name) }}
                {{ form_widget(form.name, { 'attr':  {'class': 'form-control'}}) }}
              </div>

              <div class="form-group">
                {{ form_label(form.description, 'Description') }}
                {{ form_errors(form.description) }}
                {{ form_widget(form.description, { 'attr':  { 'class': 'form-control', 'rows' : '3', 'resize' : 'none' }}) }}
              </div>

            </div>
            <div class="card-footer">

              <div class="form-group">
                <input class="btn btn-primary" type="submit" value="Enregisterer">
                <a href="#" class="btn btn-danger" data-toggle="modal" data-target="#confirmDelete" data-href="{{ path('moocms_remove_topic', { id: topic.id }) }}">Supprimer la discipline</a>
                <a class="btn btn-secondary" href="{{ path('moocms_topics') }}" role="button">Quitter</a>
              </div>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}

          </div>
        </div>
      </div>
    </div>

    <!-- Modal deletion confirmation -->
    <div class="modal fade" id="confirmDelete" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            Suppression de la discipline
          </div>
          <div class="modal-body">
            Etes-vous sure de vouloir supprimer la discipline?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
            <a class="btn btn-danger btn-ok" href="{{ path('moocms_remove_topic', { id: topic.id }) }}">Supprimer</a>
          </div>
        </div>
      </div>
    </div>

  {% endblock %}
