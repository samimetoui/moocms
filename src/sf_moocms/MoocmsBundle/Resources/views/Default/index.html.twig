{% extends 'MoocmsBundle::layout.html.twig' %}

{% block title %}Les derniers tutoriels{% endblock %}

  {% block body %}

    <div class="container page-content">
      {# <h1>Les derniers tutoriels</h1> #}
     <div class="row">

      <div class="col-lg-12">

        <div class="dropdown">
          <button class="btn btn-default dropdown-toggle" type="button" id="ddMenuLabel" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-tags"></i></button>
          <ul class="dropdown-menu" aria-labelledby="ddMenuLabel">
            <li><a class="dropdown-item" href="{{ path('moocms_homepage')}}">Tous</a></li>
            {% for topic in topics %}
              <li><a class="dropdown-item" href="{{ path('moocms_lessons_by_category',{'id' : topic.id }) }}">{{ topic.name }}</a></li>
            {% endfor %}

          </ul>
        </div>
        {# <div class="dropdown">
          <button class="btn btn-default dropdown-toggle" type="button" id="ddMenuLevel" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-thermometer"></i></button>
          <ul class="dropdown-menu" aria-labelledby="ddMenuLevel">
            <li><a class="dropdown-item" href="{{ path('moocms_homepage')}}">Tous</a></li>
            <li><a class="dropdown-item" href="{{ path('moocms_lessons_by_level',{'id' : 1 }) }}">Facile</a></li>
            <li><a class="dropdown-item" href="{{ path('moocms_lessons_by_level',{'id' : 2 }) }}">Intermédiaire</a></li>
            <li><a class="dropdown-item" href="{{ path('moocms_lessons_by_level',{'id' : 3 }) }}">Avancé</a></li>
            <li><a class="dropdown-item" href="{{ path('moocms_lessons_by_level',{'id' : 4 }) }}">Expert</a></li>
          </ul>
        </div> #}
      </div>

      <div class="col-lg-12">
        <div class="row">

          {% if lessons %}

            {% for lesson in lessons %}

              {# {% if lesson.published == true or lesson.promote == true %} #}
                <div class="col-sm-6 col-md-4 col-lg-3">
                  <div class="card hcard">
                    {% if lesson.image and lesson.image.url %}
                      <div class="card-img hcard-img">
                        <img src="{{ '/uploads_img/' ~ lesson.image.url }}" class="card-img-top" alt="...">                 
                      </div>
                    {% else %}
                      <div class="card-img hcard-img">
                        <img src="{{ '/icon-lesson.png' }}" class="card-img-top" alt="...">
                      </div>
                    {% endif %}

                    <div class="card-body hcard-body">
                      <h6 class="card-title hcard-title">{{ lesson.name }}
                        {% if lesson.published == false %}
                          <span class="badge badge-primary">Bientôt</span>
                        {% endif %}
                      </h6>
                      <p class="card-text hcard-text">{{ lesson.summary|truncate(50, true, '...') }}</p>
                      {% if lesson.published == true %}
                        <a href="{{ path('moocms_follow_lesson', {'id': lesson.id}) }}" class="btn btn-primary">Suivre</a>
                        <a href="{{ path('moocms_preview_lesson', {'id': lesson.id}) }}" class="btn btn-default">Aperçu</a>
                      {% else %}

                        <a href="{{ path('moocms_preview_lesson', {'id': lesson.id}) }}" class="btn btn-default">Aperçu</a>
                      {% endif %}
                    </div>

                  </div>
                </div>
              {# {% endif %} #}
            {% endfor %}

          {% else %}
            <div class="col-lg-12">
              <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>Désolé!</strong> Aucun tutoriel trouvé!
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
            </div>

          {% endif %}

        </div>
      </div>    

    </div>

  </div>

{% endblock %}
