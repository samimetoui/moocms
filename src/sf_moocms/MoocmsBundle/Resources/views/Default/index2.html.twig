{% extends 'MoocmsBundle::layout.html.twig' %}

{% block title %}Les derniers tutoriels{% endblock %}

{% block body %}

	<div
		class="container page-content">
		{# <h1>Les derniers tutoriels</h1> #}

		<div class="jumbotron">
			<h1 class="display-4">Bienvenue sur Lab3216</h1>
			<p class="lead">Une plateforme d'e-learning pour apprendre et pratiquer les technologies de l'information</p>
			<hr class="my-4">
			<p>Choisissez une discipline et les thèmes!</p>
			{# <p class="lead">
	        <a class="btn btn-primary btn-lg" href="#" role="button">Learn more</a>
	      </p> #}

			{{ form_start(form) }}
			<div class="row">
				<div class="col-lg-4 col-md-4">
					<div class="form-group">
						<label class="control-label">Discipline</label>
						{{ form_widget(form.topic, {'attr': {'class': 'form-control'}}) }}

					</div>
				</div>

				<div class="col-lg-7 col-md-7">
					<div class="form-group">
						<label class="control-label">Catégories</label>
						{{ form_widget(form.categories, {'attr': {'class': 'form-control select2'}}) }}

					</div>
				</div>
				<div class="col-lg-12 col-md-12">
					<button class="btn btn-primary">Rechercher</button>
				</div>
			</div>
			{{ form_end(form) }}

		</div>

		{# <div class="col-lg-12">
		      {{ pagination.getTotalItemCount }}
		    </div> #}

		<div class="col-lg-12">
			<div class="row">

				{% if pagination.count %}

				{# 	{{ dump(pagination) }} #}

					{% for lesson in pagination %}

						{# {% if lesson.published == true or lesson.promote == true %}#}
							<div class="col-sm-6 col-md-4 col-lg-4 mb-4">
								<div class="card hcard">
									{% if lesson.image and lesson.image.url %}
										<div class="card-img hcard-img">
											<img src="{{ '/uploads_img/' ~ lesson.image.url }}" class="card-img-top" alt="...">
										</div>
									{% else %}
										<div class="card-img hcard-img">
											<img src="{{ '/icon-lesson.png' }}" class="card-img-top" alt="...">
										</div>
									{% endif %}

									<div class="card-body hcard-body">
										<h6 class="card-title hcard-title">{{ lesson.name }}
											{% if lesson.published == false %}
												<span class="badge badge-primary">Bientôt</span>
											{% endif %}
										</h6>
										<p class="card-text hcard-text">{{ lesson.summary|truncate(50, true, '...') }}</p>
										{% if lesson.published == true %}
											<a href="{{ path('moocms_follow_lesson', {'id': lesson.id}) }}" class="btn btn-primary">Suivre</a>
											<a href="{{ path('moocms_preview_lesson', {'id': lesson.id}) }}" class="btn btn-default">Aperçu</a>
										{% else %}
											<a href="{{ path('moocms_preview_lesson', {'id': lesson.id}) }}" class="btn btn-default">Aperçu</a>
										{% endif %}
									</div>

								</div>
							</div>
						{# {% endif %} #}
					{% endfor %}

					<div class="col-lg-12">
						<div class="navigation">
							{{ knp_pagination_render(pagination) }}
						</div>
					</div>

				{% else %}
					<div class="col-lg-12">
						<div class="alert alert-warning alert-dismissible fade show" role="alert">
							<strong>Désolé!</strong>
							Aucun tutoriel trouvé!
							<button type="button" class="close" data-dismiss="alert" aria-label="Close">
								<span aria-hidden="true">&times;</span>
							</button>
						</div>
					</div>

				{% endif %}

			</div>
		</div>

	</div>

{% endblock %}
