	</head>
	<body>
		<nav class="navbar navbar-toggleable-md fixed-top navbar-expand-lg navbar-dark bg-dark" id="navbar">
			<div class="container">
				<a class="navbar-brand" href="{{ path('moocms_homepage') }}"><img height="60" src="{{ asset('build/logo3216.png')}}"></a>
				<button class="navbar-toggler navbar-toggler-right" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span></button>

				<div class="collapse navbar-collapse" id="navbarNav">

					{% block navigation %}
						<ul class="nav navbar-nav ml-auto">
							<li class="nav-item {{ app.request.attributes.get('_route') == 'moocms_homepage' ? 'active' }}">
								<a class="nav-link" href="{{ path('moocms_homepage') }}">Tutoriels
									<span class="sr-only">(current)</span>
								</a>
							</li>
							<li class="nav-item {{ app.request.attributes.get('_route') == 'moocms_courses' ? 'active' }}">
								<a class="nav-link" href="{{ path('moocms_courses') }}">Formations<span class="sr-only">(current)</span>
								</a>
							</li>
							{# <li class="nav-item {{ app.request.attributes.get('_route') == 'moocms_about' ? 'active' }}"><a class="nav-link " href="{{ path('moocms_about') }}">À propos</a></li> #}
							{% if is_granted("IS_AUTHENTICATED_REMEMBERED") %}

								{% if is_granted("ROLE_SUPER_ADMIN") %}
									{# Admin user #}
									<li class="nav-item dropdown">
										<a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#">Admin<span class="caret"></span>
										</a>
										<ul class="dropdown-menu">
											<li><a class="dropdown-item" href="{{ path('moocms_list_courses') }}">Formations</a></li>
											<li><a class="dropdown-item" href="{{ path('moocms_list_lessons') }}">Tutoriels</a></li>
											<li><a class="dropdown-item" href="{{ path('moocms_activities') }}">Activités</a></li>
											<li><div class="dropdown-divider"></div></li>
											<li><a class="dropdown-item" href="{{ path('moocms_users') }}">Utilisateurs</a></li>
											<li><div class="dropdown-divider"></div></li>
											<li><a class="dropdown-item" href="{{ path('moocms_topics') }}">Disciplines</a></li>
											<li><a class="dropdown-item" href="{{ path('moocms_categories') }}">Catégories</a></li>
										</ul>
									</li>
								{% elseif is_granted("ROLE_ADMIN") %}
									{# Trainer user #}
									<li class="nav-item dropdown">
										<a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#">Mon Admin<span class="caret"></span>
										</a>
										<ul class="dropdown-menu">
											<li><a class="dropdown-item" href="{{ path('moocms_list_courses') }}">Mes formation</a></li>
											<li><a class="dropdown-item" href="{{ path('moocms_list_lessons') }}">Mes tutoriels</a></li>
											<li><a class="dropdown-item" href="{{ path('moocms_activities') }}">Mes activités</a></li>
											{# <li><a class="dropdown-item" href="#">Mes évaluations</a></li> #}
											{# <li><a class="dropdown-item" href="#">...</a></li> #}
										</ul>
									</li>
									{% else %}
									{# Student user #}
								{% endif %}
								{# <li class="nav-item {{ app.request.attributes.get('_route') == 'moocms_dashboard' ? 'active' }}"><a class="nav-link" href="{{ path('moocms_dashboard') }}">Dashboard</a></li> #}
								<li class="nav-item">
									<a class="btn btn-outline-secondary" href="{{ path('fos_user_security_logout') }}"><i class="fa fa-sign-out"></i>Déconnecter</a>
										</li>
							{% else %}
								<li class="nav-item">
									<a class="btn btn-outline-secondary" href="{{ path('fos_user_registration_register') }}"><i class="fa fa-user"></i>S'inscrire</a>
								</li>
								<li class="nav-item">
									<a class="btn btn-secondary navbar-btn" href="{{ path('fos_user_security_login') }}"><i class="fa fa-sign-in"></i>Connecter</a>
								</li>
							{% endif %}
							{# <li class="nav-item {{ app.request.attributes.get('_route') == 'moocms_forum' ? 'active' }}"><a class="nav-link" href="{{ path('moocms_forum') }}">Forum</a></li> #}
						</ul>
					{% endblock %}

				</div>
			</div>
		</nav>

		{% block body %}{% endblock %}

